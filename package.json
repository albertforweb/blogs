{
  "name": "blogs",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted blog CMS inspired by WordPress, built with Node.js, Express and React.",
  "type": "module",
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "setup": "npm install && npm run build",
    "dev": "concurrently -k -n server,admin -c blue,green \"npm run dev:server\" \"npm run dev:admin\"",
    "dev:server": "node server/index.js",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w admin",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "marked": "^15.0.7",
    "multer": "^2.0.1",
    "sanitize-html": "^2.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
